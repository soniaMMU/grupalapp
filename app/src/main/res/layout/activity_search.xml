<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Barra de búsqueda -->
    <EditText
        android:id="@+id/search_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Buscar productos..."
        android:padding="8dp"/>

    <!-- Contenedor para las categorías -->
    <LinearLayout
        android:id="@+id/categories_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp">
    </LinearLayout>

    <!-- RecyclerView para mostrar resultados -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="16dp" />

    <!-- Botón "Más categorías" -->
    <Button
        android:id="@+id/more_categories_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Más categorías"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp" />

    <!-- Barra de filtro por precio -->
    <TextView
        android:id="@+id/price_filter_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Filtrar por precio"
        android:layout_marginTop="16dp"/>

    <SeekBar
        android:id="@+id/price_filter_seekbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"/>
</LinearLayout>