<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/chat_item_background"
    android:padding="12dp"
    android:layout_marginBottom="8dp">

    <!-- ID del chat en la esquina superior derecha -->
    <TextView
        android:id="@+id/tvChatId"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:textSize="12sp"
        android:textColor="@color/black"
        android:textStyle="italic"
        android:text="ID: chat1" />

    <!-- Nombre del producto -->
    <TextView
        android:id="@+id/tvProductoNombre"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/tvChatId"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:text="Nombre del producto" />

    <!-- Último mensaje -->
    <TextView
        android:id="@+id/tvLastMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/tvProductoNombre"
        android:layout_marginTop="4dp"
        android:textSize="14sp"
        android:textColor="@color/black"
        android:text="Último mensaje aquí" />

    <!-- Información del vendedor -->
    <TextView
        android:id="@+id/tvVendedorInfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/tvLastMessage"
        android:layout_marginTop="4dp"
        android:textSize="14sp"
        android:textColor="@color/black"
        android:text="Vendedor: ID - Nombre" />
</RelativeLayout>